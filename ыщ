function generator(){const c=current();return `${!state.keyring?.available.length?vaultPanel():''}${!c?`<section class="hero"><div class="eyebrow">НОВЫЕ СТРУКТУРЫ · ПАМЯТЬ ИСПЫТАНИЙ</div><h2>Задача. База. Испытания.</h2><p>Подключите модель генератора, добавьте примеры и задачу. Генератор анализирует принципы и создаёт отдельную новую структуру.</p></section><section class="panel">${startForm()}</section>`:`<section class="panel"><div class="row spread"><div><h2>${esc(c.target_snapshot.title)}</h2><p class="help">${esc(c.domain)}${c.persona?' · Персона '+esc(c.persona):''}</p></div><span class="badge good">${c.channel==='api'?'ИИ через API':'Локальный поиск'}</span></div>${c.objective?`<div class="objective-summary"><strong>Задача</strong><p>${esc(c.objective)}</p></div>`:'<p class="notice">В старом проекте нет текста задачи. Начните новую задачу; история сохранена.</p>'}<details ${startExpanded||!c.objective?'open':''}><summary>Новая задача</summary>${startForm()}</details></section>${activePanel(c)}`}${modelsPanel(true)}<details class="panel"><summary>Как строится следующий промпт</summary><ol><li>Анализатор изучает оригиналы и сохраняет абстрактные принципы и зависимости.</li><li>Планировщик получает принципы, точную задачу и полные отчёты, сравнивает разные подходы.</li><li>Автор пишет новую структуру и оформление, не получая оригинальных примеров.</li><li>Программа ищет текстовые заимствования. Отдельный вызов модели проверяет задачу и структурную новизну.</li><li>Только реальная проверка в целевой модели определяет результат. Accept на установку не заменяет выполнение задания.</li></ol><p class="help">Режим API использует инструкции и память примеров, не изменяя веса модели. Локальный режим сохраняет прежний составной поиск.</p></details>`;}

function activePanel(c){const j=job(c),a=attempt(c);if(j?.engine==='ai-1'&&j.status!=='completed')return aiJobPanel(j);if(j?.status==='search_paused')return searchPause(j,c);if(j&&j.channel!=='local'&&['waiting_for_result','queued','running','failed','interrupted','cancelled'].includes(j.status))return `<section class="panel"><h2>Продолжить работу</h2><p>В этом проекте остался запрос предыдущей версии. Задача и история сохранены.</p>${c.objective?`<button class="primary" data-next="${c.id}">Собрать заново</button>`:''}</section>`;if(j&&['waiting_for_result','queued','running','failed','interrupted','cancelled'].includes(j.status))return jobPanel(j,c);return a?attemptPanel(a,c):empty('Начните генерацию.');}

function aiJobPanel(j){const running=['queued','running'].includes(j.status),cp=j.checkpoint||{},rejected=cp.review?.approved===false;return `<section class="panel"><div class="eyebrow">ГЕНЕРАЦИЯ ЧЕРЕЗ API</div><h2>${esc(running?stageNames[j.stage]||j.stage:rejected?'Черновик требует доработки':'Генерация приостановлена')}</h2>${j.current_model?`<p>Модель: <strong>${esc(j.current_model)}</strong></p>`:''}${j.current_connection?`<p class="help">Подключение: ${esc(j.current_connection)}</p>`:''}<div class="pipeline"><span class="badge">Примеры: ${cp.cards?.length||0}/${j.input.sources?.length||0}</span><span class="badge ${cp.plan?'good':''}">План ${cp.plan?'✓':''}</span><span class="badge ${cp.design?'good':''}">Черновик ${cp.design?'✓':''}</span><span class="badge ${cp.review?.approved?'good':rejected?'warn':''}">Проверка ${cp.review?.approved?'✓':rejected?'— есть замечания':''}</span></div><p class="help">API-запросов: ${j.requests_total||0}. Завершённые этапы сохраняются. Оставьте вкладку открытой.</p>${!running&&cp.design?`<details class="draft-panel" open><summary>Черновик промпта — проверка не пройдена</summary><pre class="prompt-output">${esc(cp.design.prompt||cp.design.blocks.map(b=>b.text).join('\n\n'))}</pre><button class="small" data-copy-draft="${j.id}">Копировать черновик</button><p class="help">Это текст промпта, а не замечания проверяющей модели. Он ещё не прошёл все проверки и не испытан на цели.</p></details>`:''}${!running&&rejected?`<details class="review-panel"><summary>Замечания проверяющей модели · ${cp.review.issues.length}</summary><p>${esc(cp.review.summary)}</p><ol>${cp.review.issues.map(x=>`<li>${esc(x.detail)}</li>`).join('')}</ol></details>`:''}${j.error?`<p class="notice">${esc(j.error_code==='review_rejected'||rejected?'Проверяющая модель отклонила черновик. «Доработать по замечаниям» запустит новый запрос с её замечаниями.':j.error)}</p>`:''}${j.status==='failed'&&j.retry_at?`<p class="help">Автоматический повтор после ${esc(new Date(j.retry_at).toLocaleString('ru-RU'))}, пока вкладка открыта.</p>`:''}<div class="actions">${running?`<button data-${j.status==='queued'?'cancel':'stop'}-job="${j.id}">Остановить</button>`:`<button class="primary" data-resume-ai="${j.id}" ${j.retry_at>Date.now()?'disabled':''}>${rejected?'Доработать по замечаниям':'Продолжить с сохранённого этапа'}</button><button data-nav="settings">Подключение и модели</button>${j.status==='failed'&&j.retry_at?`<button data-cancel-job="${j.id}">Остановить автоповтор</button>`:''}`}</div>${j.notifications?.length?`<details><summary>Переключения подключений · ${j.notifications.length}</summary>${j.notifications.map(x=>`<p class="help">${esc(x.message)}</p>`).join('')}</details>`:''}${j.telemetry?.length?`<details><summary>Диагностика · ${j.telemetry.length}</summary>${j.telemetry.slice(-12).map(x=>`<p class="help">${esc(stageNames[x.stage]||x.stage)} · ${esc(x.connection||'')} · ${esc(x.model||'')} · ${esc(x.code)}${x.status?' · HTTP '+x.status:''}</p>`).join('')}</details>`:''}</section>`;}

function searchPause(j,c){return `<section class="panel"><h2>Нужна следующая порция поиска</h2><p>${esc(j.error)}</p><p class="help">В последней порции рассмотрено сочетаний: ${j.search?.proposed||0}. Позиция поиска сохранена. Это не результат испытания модели.</p><div class="actions"><button class="primary" data-next="${c.id}">Продолжить поиск</button><button data-nav="seeds">Расширить базу</button></div><details><summary>Причины отсева</summary>${(j.search?.rejected||[]).slice(0,8).map(x=>`<p>${esc(x.reason)}</p>`).join('')||'<p class="help">Ранее испытанные или слишком близкие структуры.</p>'}</details></section>`;}

function jobPanel(j,c){return `<section class="panel"><h2>Сборка не завершена</h2><p class="notice">${esc(j.error||'Операция прервана')}</p><p>История сохранена. Можно повторить локальную сборку.</p><form id="retry-form"><button class="primary">Собрать локально</button></form></section>`;}

function attemptPanel(a,c){const r=report(a);return `<section class="panel"><div class="eyebrow">ПРОМПТ ${a.number} · ${a.status==='reported'?'ЕСТЬ ОТЧЁТ':'ЕЩЁ НЕ ИСПЫТАН'}</div><div class="row spread"><h2>${esc(a.title)}</h2><button class="primary" data-copy-attempt="${a.id}">Копировать промпт</button></div><pre class="prompt-output">${esc(a.prompt)}</pre>${a.provenance.channel==='local'?logicPanel(a,c):aiAttemptPanel(a)}${a.provenance.channel!=='local'&&a.provenance.plan?.task_contract?`<details><summary>Как учтена задача</summary><p>${esc(a.provenance.plan.task_contract.deliverable)}</p><p class="help">Критерии проверки</p><ul>${a.provenance.plan.task_contract.success_criteria.map(t=>`<li>${esc(t)}</li>`).join('')}</ul>${a.provenance.plan.task_contract.open_questions.length?`<p class="help">Открытые вопросы: ${esc(a.provenance.plan.task_contract.open_questions.join('; '))}</p>`:''}</details>`:''}<details><summary>Что изменилось и почему</summary><p>${esc(a.analysis.summary)}</p><p>${esc(a.strategy.summary)}</p><p class="help">${esc(a.strategy.why_changed)}</p><p class="help">${['local_rules','local_search'].includes(a.provenance.review_type)?'Программная проверка':a.provenance.review_type==='separate_model_call'?'Проверен отдельным вызовом модели':'Самопроверка модели в чате'}: ${esc(a.provenance.review.summary)}</p></details></section>${a.status==='awaiting_setup'?setupForm(a):a.status==='awaiting_task'?taskReport(a,r):completedReport(a,r,c)}`;}
function logicPanel(a,c){const info=a.provenance.search;if(!info)return '<p class="help">Эта версия создана предыдущим движком. Её отчёт сохраняется в истории.</p>';return `<details><summary>Почему выбрана эта структура</summary><p>${esc(a.strategy.why_changed)}</p><p class="help">Сравнено сочетаний: ${info.evaluated}. Итерация поиска: ${info.round}. Баллы служат выбору вариантов и не являются вероятностью успеха.</p><div class="table-wrap"><table><thead><tr><th>Часть</th><th>Компонент</th><th>Опыт</th></tr></thead><tbody>${info.components.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.label)}${x.source_id?' · из вашей базы':''}</td><td>${Number(x.support).toFixed(2)}</td></tr>`).join('')}</tbody></table></div>${info.changes.length?`<p>Изменены части: ${esc(info.changes.map(x=>x.name).join(', '))}.</p>`:''}${info.parents.length?`<p class="help">Использовано прежних структур: ${info.parents.length}.</p>`:''}${info.diagnosis.signals.length?`<h3>Фрагменты ответов, повлиявшие на выбор</h3>${info.diagnosis.signals.map(x=>`<p>${esc(x.name)} · ход ${x.turn}</p><pre>${esc(x.excerpt)}</pre>`).join('')}<p class="help">Найденные фразы указывают на возможную причину, но не доказывают её.</p>`:''}<p class="help">Опыт частей отражает совместное появление в испытаниях, а не доказательство эффективности каждой части по отдельности.</p></details>`;}

function setupForm(a){return `<section class="panel"><div class="eyebrow">ШАГ 2 · ОТВЕТ НА ПРОМПТ</div><h2>Как модель ответила на установку?</h2><p class="help">Отправьте промпт в новом разговоре с целевой моделью и сохраните её фактический ответ.</p><form id="setup-${a.id}" data-form="setup" data-attempt="${a.id}">${area('Полный ответ модели','response','','required rows="6"')}${select('Результат установки','decision',verdictOptions(true))}<p class="notice" id="accept-note" hidden>После accept потребуется отдельный запрос по категории и фактический ответ на него. Само согласие не считается успехом.</p><button class="primary">Сохранить ответ</button></form></section>`;}
function toggleSetup(){const a=state&&attempt(),form=a&&$('#setup-'+a.id),note=$('#accept-note');if(note)note.hidden=form?.elements?.namedItem('decision')?.value!=='accept';}
function turnsList(r){return r.turns.map((t,i)=>`<details class="entry"><summary>Задание ${i+1} · ${esc(t.decision)}</summary><p class="help">Ваш запрос</p><pre>${esc(t.request)}</pre><p class="help">Ответ модели</p><pre>${esc(t.response)}</pre>${t.notes?`<p>${esc(t.notes)}</p>`:''}</details>`).join('');}
function taskReport(a,r){const previous=state.reports.find(x=>x.attempt_id===a.previous_attempt_id),c=state.campaigns.find(x=>x.id===a.campaign_id),repeatRequest=!r.turns.length?previous?.turns[0]?.request||c?.objective||'':'';return `<section class="panel"><div class="eyebrow">ШАГ 3 · РЕАЛЬНЫЕ ЗАДАНИЯ</div><h2>${r.turns.length?'Проверка продолжения':'Промпт принят. Проверьте задание.'}</h2><details><summary>Ответ на установку · accept</summary><pre>${esc(r.setup.response)}</pre></details>${turnsList(r)}<form id="task-${a.id}" data-form="task" data-attempt="${a.id}">${area('Запрос, который вы отправили целевой модели','request',repeatRequest,'required rows="4"')}<button type="button" class="small" data-copy-request="${a.id}">Копировать запрос</button>${repeatRequest?`<p class="help">${previous?.turns.length?'Подставлен запрос из прошлой проверки.':'Подставлена исходная задача.'} Если вы отправили другую формулировку, исправьте её здесь.</p>`:''}${area('Полный ответ модели на этот запрос','response','','required rows="6"')}${select('Результат задания','decision',verdictOptions())}<details><summary>Дополнительные наблюдения</summary>${area('Замечания — необязательно','notes')}</details><button class="primary">Добавить в отчёт</button></form>${r.turns.length?`<div class="divider"></div><p class="help">Можно проверить ещё одно задание в этом же разговоре или завершить отчёт.</p><button class="primary" data-finish="${a.id}">Завершить отчёт и собрать следующий промпт</button><button class="small" data-save-report="${a.id}">Только сохранить отчёт</button>`:''}</section>`;}
function completedReport(a,r,c){const info=c.objective?PromptLab.searchDescribe(state,c):null;return `<section class="panel"><div class="eyebrow">ОТЧЁТ СОХРАНЁН</div><h2>${esc(outcomes[r.outcome])}</h2><details><summary>Полный отчёт</summary><p>Установка: ${esc(r.setup.decision)}</p><pre>${esc(r.setup.response)}</pre>${turnsList(r)}</details>${info?`<p class="help">Испытанных версий в проекте: ${info.trial_count}. Следующая версия использует завершённый отчёт.</p>${info.confirmed.length?`<p>По вашим отчётам, выполнены задания у ${info.confirmed.length} версий. Они сохранены в истории.</p>`:''}<button class="primary" data-next="${c.id}">Создать следующий промпт по отчёту</button>`:'<p class="notice">Для продолжения начните новую задачу с полным текстом.</p>'}</section>`;}

function seeds(){return `<section class="hero"><h2>База исходных примеров</h2><p>Загрузите скелеты и кожи один раз. В режиме API оригиналы изучает анализатор; автор получает только принципы. Выбирать исходный скелет для каждой генерации не нужно.</p></section><div class="grid"><section class="panel"><form id="seed-form">${input('Название','title','','required maxlength="200"')}${area('Полный исходный текст','text','','required rows="10" spellcheck="false"')}${input('Категории через запятую','domains','general')}${input('Для какой модели создавался — необязательно','target_hint')}${area('Наблюдения и условия применения','notes')}<button class="primary">Добавить в базу</button></form><div class="divider"></div><label>Импорт TXT, MD, JSON, JSONL<input id="seed-files" type="file" multiple accept=".txt,.md,.json,.jsonl"></label><button data-import-seeds>Импортировать файлы</button></section><section class="panel"><h2>Примеры · ${state.seeds.length}</h2>${state.seeds.length?state.seeds.map(s=>{const parsed=PromptLab.parseReference(s);return `<details class="entry"><summary>${esc(s.title)}${s.enabled===false?' · отключён':''}</summary><p class="help">${esc(s.domains.join(' · '))}${s.target_hint?' · '+esc(s.target_hint):''}</p><pre>${esc(s.text)}</pre><p>${esc(s.notes)}</p>${s.ai_analysis?`<details><summary>Сохранённый разбор · ${esc(s.ai_analysis.model)}</summary><p>${esc(s.ai_analysis.card.summary)}</p><p>${esc(s.ai_analysis.card.mechanism)}</p><ul>${s.ai_analysis.card.principles.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></details>`:'<p class="help">ИИ-разбор появится после генерации через API.</p>'}<p>Фрагментов для локального режима: ${parsed.fragments.length}.</p><ul>${parsed.fragments.map(f=>`<li>${esc(PromptLab.searchSlots[f.slot])}: ${esc(f.text.slice(0,140))}</li>`).join('')}</ul>${parsed.excluded.map(x=>`<p class="help">Не использован фрагмент ${x.index+1}: ${esc(x.reason)}</p>`).join('')}<button class="small" data-toggle-seed="${s.id}">${s.enabled===false?'Включить в поиск':'Отключить от поиска'}</button></details>`;}).join(''):empty('База пока пуста. Доступны общие конструкции; проверенных джейлбрейков в поставке нет.')}<p class="help">Локальный разбор выполняется по правилам; ИИ-разбор — отдельным запросом. Оригиналы сохраняются. В заметках указывайте реальные задания, ответы, версию модели и условия испытания.</p></section></div>`;}

function history(){return `<section class="panel"><h2>Проекты и отчёты</h2>${state.campaigns.length?state.campaigns.map(c=>`<div class="entry"><div class="row spread"><h3>${esc(c.target_snapshot.title)} · ${esc(c.domain)}</h3><button data-open-campaign="${c.id}">Открыть текущую работу</button></div><p class="help">${c.persona?'Персона '+esc(c.persona)+' · ':''}${esc(c.created)}</p><p>${esc(c.objective||'Задача не была указана в старой версии')}</p>${state.attempts.filter(a=>a.campaign_id===c.id).map(a=>{const r=report(a);return `<details><summary>Промпт ${a.number} · ${r?.status==='complete'?esc(outcomes[r.outcome]):'Отчёт не завершён'}</summary><pre>${esc(a.prompt)}</pre><p>${esc(a.strategy.why_changed)}</p>${r?`<p>Установка: ${esc(r.setup.decision)}</p><pre>${esc(r.setup.response)}</pre>${turnsList(r)}`:''}</details>`;}).join('')}</div>`).join(''):empty('После первой генерации здесь появится история.')}<p class="help">Неудачные версии остаются в истории и передаются как отрицательный опыт.</p></section>${legacyPanel()}`;}
function legacyPanel(){if(!state.candidates.length&&!state.runs.length)return '';return `<section class="panel"><h2>Архив предыдущей версии</h2><p class="help">Ранние скелеты и диалоги сохранены. Наблюдения по той же модели и категории доступны новому генератору.</p>${state.runs.map(r=>`<details><summary>${esc(r.target_snapshot.title)} · ${esc(r.task_snapshot.domain)} · ${esc(r.created)}</summary><p>${esc(r.task_snapshot.objective)}</p>${r.messages.map(m=>`<p class="help">${esc(m.role)} · ${esc(m.purpose)}</p><pre>${esc(m.content)}</pre>`).join('')}</details>`).join('')}<details><summary>Ранние промпты · ${state.candidates.length}</summary>${state.candidates.map(c=>`<h3>${esc(c.title)}</h3><pre>${esc(c.compiled)}</pre>`).join('')}</details></section>`;}
function aiAttemptPanel(a){const p=a.provenance;if(p.engine_version!=='ai-1')return '';return `<details><summary>Как создан и проверен промпт</summary><p>Автор: ${esc(p.author.model)} · ${esc(p.author.provider)}</p><p>Проверка: ${esc(p.critic.model)}</p><p>Разобрано исходников: ${p.learned_sources.length}. В контекст вошло: ${p.context.reference_library.included}.</p><p class="help">Оригиналы примеров не передавались автору. Проверено источников и прежних версий: ${p.novelty.checked_sources}. Максимальное текстовое сходство: ${(100*p.novelty.max_jaccard).toFixed(1)}% по 5-словным сочетаниям.</p><p class="help">Текстовая проверка и оценка модели не доказывают полную смысловую уникальность. Статус результата — ещё не испытан на целевой модели.</p><ul>${p.stages.map(x=>`<li>${esc(stageNames[x.stage]||x.stage)} · ${esc(x.model)}${x.usage?.total_tokens?' · '+x.usage.total_tokens+' токенов':''}</li>`).join('')}</ul></details>`;}
function vaultPanel(){if(!state.keyring?.embedded)return '';const ready=state.keyring.available.length>0;return `<${ready?'details':'section'} class="panel vault-panel">${ready?'<summary>Встроенный набор ключей</summary>':'<h2>Разблокировать встроенные подключения</h2>'}<p>${state.keyring.embedded_count} ключей уже находятся в этом HTML в зашифрованном виде. Введите код из сообщения со сборкой один раз.</p><form id="vault-form" autocomplete="off">${input('Код разблокировки','passphrase','','type="password" required autocomplete="off" autocapitalize="none" spellcheck="false"')}<label class="check-label"><input name="remember_key" type="checkbox" checked>Запомнить доступ на этом устройстве</label><button class="primary">Разблокировать набор</button></form><p class="help">При сохранённом доступе повторный ввод не нужен. Во временном режиме код потребуется после закрытия вкладки. Код не публикуйте вместе с HTML.</p></${ready?'details':'section'}>`;}
function modelsPanel(compact=false){const cfg=PromptLab.aiConfig(state);if(!cfg)return '';const ranked=PromptLab.rankAIModels(cfg.catalog||[],cfg.stats||{},0,cfg.max_tokens),best=ranked[0]?.id,rows=[...ranked,...(cfg.catalog||[]).filter(m=>!ranked.some(r=>r.id===m.id))],busy=state.jobs.some(j=>['running','queued'].includes(j.status));const content=`<p class="help">Основная модель: <strong>${esc(cfg.model==='auto'?(best?'Авто · '+best:'Автовыбор'):cfg.model)}</strong> · ${esc(cfg.label||cfg.provider)}</p><label>Подключение для выбора модели<select id="model-connection" ${busy?'disabled':''}>${PromptLab.aiConnections(state).map(c=>`<option value="${c.id}" ${c.id===cfg.id?'selected':''}>${esc(c.label||c.provider)}</option>`).join('')}</select></label><div class="actions"><button type="button" data-pick-model="auto" data-connection-id="${cfg.id}" aria-pressed="${cfg.model==='auto'}" ${busy?'disabled':''}>Автовыбор ${cfg.model==='auto'?'✓':''}</button><button type="button" data-refresh-models="${cfg.id}">Обновить каталог</button></div><p class="help">Нажмите на карточку. Эта модель будет анализировать и писать промпт; проверка по возможности выполняется другой моделью. При недоступности основного подключения включится резервное с уведомлением.</p><div class="model-grid" role="group" aria-label="Модели генератора">${rows.map(m=>{const cooling=(cfg.stats?.[m.id]?.cooldown_until||0)>Date.now(),compatible=ranked.some(r=>r.id===m.id);return `<button type="button" class="model-card ${cfg.model===m.id?'selected':''}" data-pick-model="${esc(m.id)}" data-connection-id="${cfg.id}" aria-pressed="${cfg.model===m.id}" ${busy||!compatible?'disabled':''}>${m.id===best?'<span class="best-badge">the best</span>':''}<strong>${esc(m.name||m.id)}</strong><span class="model-id">${esc(m.id)}</span><span class="model-reasons">${esc(m.reasons?.join(' · ')||'Контекст и доступность')} · ${Number(m.context_length).toLocaleString('ru-RU')} токенов</span><span>${cfg.model===m.id?'Выбрана':cooling?'Временно недоступна':!compatible?'Не подходит по объёму':'Выбрать'}</span></button>`;}).join('')}</div>${!rows.length?empty('Нажмите «Обновить каталог», чтобы выбрать модель.'):''}<p class="help">the best — рекомендация среди доступных моделей этого подключения по возможностям и накопленной истории. Это не универсальный рейтинг качества.</p>${cfg.quota?`<p class="help">Остаток дневной квоты OpenRouter: ${esc(cfg.quota.remaining)} из ${esc(cfg.quota.limit)}. Данные на момент последней проверки.</p>`:''}`;return compact?`<details class="panel model-picker"><summary>Выбрать модель генератора · ${esc(cfg.model)}</summary>${content}</details>`:`<section class="panel model-picker"><h2>Модель генератора</h2>${content}</section>`;}
function connectionsPanel(){const rows=state.settings.filter(c=>c.generator_version==='ai-1');if(!rows.length)return '';return `<section class="panel"><h2>Основное и резервные подключения</h2>${rows.map(c=>{const status=c.enabled===false?'Отключено':c.key_status==='unavailable'?'Нужна проверка ключа':!state.keyring.available.includes(c.id)?'Нужно разблокировать':c.cooldown_until>Date.now()?'Ожидание до '+new Date(c.cooldown_until).toLocaleTimeString('ru-RU'):'Доступ сохранён';return `<div class="entry"><div class="row spread"><strong>${esc(c.label||c.provider)}</strong><span class="badge">${esc(status)}</span></div><p class="help">${esc(c.model)}${c.primary?' · основное':''}</p><div class="actions"><button class="small" data-toggle-connection="${c.id}">${c.enabled===false?'Включить':'Отключить'}</button>${c.key_status==='unavailable'&&c.enabled!==false?`<button class="small" data-retry-connection="${c.id}">Проверить заново</button>`:''}<button class="small" data-forget-connection="${c.id}">Удалить ключ с устройства</button></div></div>`;}).join('')}<p class="help">При общем лимите сервис пропускается целиком. Если все подключения ждут сброса, приложение сохраняет этапы и повторяет запрос после паузы. Уведомления появляются здесь, пока сайт открыт.</p></section>`;}
function settings(){return `<section class="hero"><h2>Подключение генератора</h2><p>Разблокируйте встроенный набор, выберите модель и начните задачу. Переключением резервных подключений управляет приложение.</p></section>${vaultPanel()}${modelsPanel()}${connectionsPanel()}<details class="panel"><summary>Добавить другой API-ключ</summary><form id="api-form" autocomplete="off">${select('Провайдер','provider',Object.entries(PromptLab.aiProviders).map(([id,x])=>`<option value="${id}">${esc(x.label)}</option>`).join(''))}${input('Полный API-ключ','api_key','','type="password" required autocomplete="new-password"')}${input('Модель генератора','model','auto','required')}${input('Лимит ответа, токенов','max_tokens',8192,'type="number" min="2048" max="16384" step="1024"')}<label class="check-label"><input type="checkbox" name="remember_key" checked>Запомнить доступ на этом устройстве</label><button class="primary">Подключить и проверить</button></form><p class="help">Задача, примеры и отчёты передаются провайдерам при генерации. OpenRouter использует только модели с нулевыми ценами. Для Groq и Gemini действует тариф вашего аккаунта.</p></details><section class="panel"><h2>Целевые модели для ручного испытания</h2><form id="target-form">${input('Название модели','model','','required maxlength="200" placeholder="Своя модель"')}${input('Версия или условия проверки','version','профиль')}${area('Наблюдения — необязательно','notes')}<button>Добавить модель</button></form>${state.targets.map(t=>`<div class="entry"><strong>${esc(t.title)}</strong><p class="help">${esc(t.version)}</p></div>`).join('')}</section>`;}


function dataView(){return `<div class="grid"><section class="panel"><h2>Сохранение и перенос</h2><p>${temporary?'Записи находятся только в памяти текущей вкладки. Скачайте резервную копию перед закрытием или обновлением страницы.':'База примеров, промпты, фактические ответы и отчёты хранятся в браузере на этом устройстве.'}</p><button class="primary" data-export>Скачать резервную копию</button><p class="help">Скачайте копию перед очисткой данных браузера или сменой адреса сайта. Ключи API не экспортируются.</p><div class="divider"></div><form id="restore-form"><label>Резервная копия<input id="backup-file" type="file" accept=".json" required></label><label class="check-label"><input name="confirm_replace" type="checkbox" required>Заменить текущие данные выбранной копией</label><button>Восстановить</button></form><p class="help">Поддерживаются резервные копии предыдущих версий.</p></section><section class="panel"><h2>Один HTML для телефона</h2><ol><li>Замените index.html в корне своего репозитория.</li><li>GitHub Pages: main → /(root).</li><li>После публикации обновите страницу сайта.</li></ol><p>${temporary?'Сейчас включён временный режим: скачайте копию перед закрытием страницы.':'Промпты и отчёты остаются после обновления сайта при том же адресе и браузере.'}</p><button data-persist>Запросить постоянное хранение</button><p class="help">Этот HTML работает с телефона без сервера. Для ИИ-генерации нужен интернет и ключ. Локальный режим работает без API. Испытания в целевой модели проводятся вручную.</p></section></div>`;}
const views={generator,seeds,history,settings,data:dataView};
async function copy(text){try{await navigator.clipboard.writeText(text);}catch{const area=document.createElement('textarea');area.value=text;area.className='clipboard-helper';document.body.appendChild(area);area.select();const ok=document.execCommand('copy');area.remove();if(!ok)throw Error('Выделите текст и скопируйте вручную');}toast('Скопировано');}
async function backup(fromCache=false){let data;if(fromCache){const snapshot=engine?.store?.lastSnapshot||recoverySnapshot;if(!snapshot)throw Error('Нет прочитанной копии данных. Старая база сейчас недоступна.');const reader=new PromptLab.Engine(new PromptLab.MemoryStore(snapshot),{locks:null});await reader.init();data=await reader.export();}else data=await api('/api/export');const url=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'})),link=document.createElement('a');link.href=url;link.download='promptlab-backup-'+new Date().toISOString().slice(0,10)+'.json';document.body.appendChild(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),10000);}
async function next(c,channel){const result=await api('/api/simple/next',{campaign_id:c.id,revision:c.revision,channel:channel||(PromptLab.aiConfig(state)?'api':'local')});selectedCampaign=result.campaign_id;remember();await load();}
function discard(formId){delete drafts[formId];remember();}
document.addEventListener('input',event=>{dirty=true;capture(event.target.form);});
document.addEventListener('change',async event=>{if(event.target.id==='model-connection'){try{await api('/api/ai/select',{id:event.target.value,model:'auto'});await load();}catch(error){handleError(error);}return;}capture(event.target.form);if(event.target.form?.id==='api-form'&&event.target.name==='provider'){const f=event.target.form;f.elements.namedItem('api_key').value='';f.elements.namedItem('model').value='auto';}toggleSetup();});
document.addEventListener('keydown',event=>{if(event.key==='Escape')closeMenu();});
document.addEventListener('click',async event=>{
 const exported=event.target.closest('[data-export]');if(exported){event.preventDefault();try{await backup();}catch(error){handleError(error);}return;}
 const button=event.target.closest('button');if(!button)return;
 try{
  const d=button.dataset;
  if(button.id==='menu-toggle'){const open=document.body.classList.toggle('nav-open');$('#nav-backdrop').hidden=!open;button.setAttribute('aria-expanded',String(open));return;}
  if(button.id==='nav-backdrop'){closeMenu();return;}
  if(button.id==='use-memory'){button.disabled=true;await initialize(true);return;}
  if(button.id==='retry-storage'){button.disabled=true;try{await initialize();}catch(error){showStartupError(error);}return;}
  if(d.cacheBackup!==undefined){await backup(true);return;}
  if(d.returnTask!==undefined){startExpanded=true;returnToTask=false;remember();go('generator');return;}
  if(d.nav){go(d.nav);return;}
  if(button.id==='refresh'){await load();return;}
  if(d.openCampaign){selectedCampaign=d.openCampaign;remember();go('generator');return;}
  if(d.copyJob){await copy(state.jobs.find(j=>j.id===d.copyJob).prompt);return;}
  if(d.copyRequest){const value=$('#task-'+d.copyRequest)?.elements?.namedItem('request')?.value;if(!value?.trim())throw Error('Сначала напишите запрос');await copy(value);return;}
  if(d.copyDraft){const cp=state.jobs.find(j=>j.id===d.copyDraft)?.checkpoint;if(!cp?.design)throw Error('Черновик отсутствует');await copy(cp.design.prompt||cp.design.blocks.map(b=>b.text).join('\n\n'));return;}
  if(d.copyAttempt){await copy(state.attempts.find(a=>a.id===d.copyAttempt).prompt);return;}
  if(d.persist!==undefined){const ok=await navigator.storage?.persist?.();toast(ok?'Постоянное хранение предоставлено':'Браузер оставил обычный режим хранения');return;}
  button.disabled=true;
  if(d.resumeAi){await api('/api/ai/resume',{job_id:d.resumeAi});await load();return;}
  if(d.refreshModels!==undefined){await api('/api/ai/models',{id:d.refreshModels||undefined});await load();toast('Каталог обновлён');return;}
  if(d.pickModel!==undefined){await api('/api/ai/select',{id:d.connectionId,model:d.pickModel});await load();toast(d.pickModel==='auto'?'Включён автовыбор':'Выбрана модель: '+d.pickModel);return;}
  if(d.toggleConnection||d.retryConnection){await api('/api/ai/toggle',{id:d.toggleConnection||d.retryConnection,retry:!!d.retryConnection});await load();return;}
  if(d.forgetConnection){await api('/api/ai/forget',{id:d.forgetConnection});await load();toast('Ключ удалён с устройства');return;}
  if(d.toggleSeed){const seed=state.seeds.find(x=>x.id===d.toggleSeed);await api('/api/seeds/toggle',{seed_id:seed.id,revision:seed.revision});await load();return;}
  if(d.importSeeds!==undefined){const files=[...$('#seed-files').files];if(!files.length)throw Error('Выберите файлы');await api('/api/seeds/import',{files:await Promise.all(files.map(async f=>({name:f.name,content:await f.text()})))});await load();toast('Примеры добавлены');return;}
  if(d.startJob){await api('/api/jobs/start',{job_id:d.startJob});await load();return;}
  if(d.stopJob||d.cancelJob){await api(d.stopJob?'/api/jobs/interrupt':'/api/jobs/cancel',{job_id:d.stopJob||d.cancelJob});await load();return;}
  if(d.finish||d.saveReport){const a=state.attempts.find(x=>x.id===(d.finish||d.saveReport));await api('/api/simple/finish',{attempt_id:a.id,revision:a.revision});discard('task-'+a.id);await load();if(d.finish&&current()?.objective)await next(current());else toast('Полный отчёт сохранён');return;}
  if(d.next){await next(state.campaigns.find(c=>c.id===d.next));return;}
 }catch(error){handleError(error);}finally{button.disabled=false;}
});
document.addEventListener('submit',async event=>{
 event.preventDefault();const form=event.target,button=event.submitter,data=Object.fromEntries(new FormData(form));capture(form);if(button)button.disabled=true;
 try{
  let message='Сохранено';
  if(form.id==='start-form'){data.channel=data.channel||(PromptLab.aiConfig(state)?'api':'local');if(!data.objective?.trim())throw Error('Опишите задачу, для которой нужен промпт');const result=await api('/api/simple/start',data);selectedCampaign=result.campaign_id;startExpanded=false;returnToTask=false;remember();message=data.channel==='api'?'Генерация запущена':result.paused?'Позиция поиска сохранена':'Новая структура собрана';}
  else if(form.dataset.form==='setup'||form.dataset.form==='task'){const a=state.attempts.find(x=>x.id===form.dataset.attempt);await api('/api/simple/'+form.dataset.form,{...data,attempt_id:a.id,revision:a.revision});}
  else if(form.id==='retry-form'){await next(current(),data.channel);discard(form.id);return;}
  else if(form.id==='vault-form'){const result=await api('/api/ai/unlock',{passphrase:data.passphrase,remember_key:form.elements.namedItem('remember_key').checked});message='Разблокировано подключений: '+result.saved;}
  else if(form.id==='api-form'){await api('/api/ai/connect',{...data,remember_key:form.elements.namedItem('remember_key').checked});message='Подключение проверено, каталог загружен';}
  else if(form.id==='seed-form'){await api('/api/seeds',{...data,domains:data.domains.split(',').map(x=>x.trim()).filter(Boolean)});}
  else if(form.id==='target-form'){await api('/api/targets',{title:data.model,model:data.model,version:data.version,notes:data.notes,mode:'manual'});}
  else if(form.id==='restore-form'){const file=$('#backup-file').files[0];if(!file||file.size>50000000)throw Error('Выберите JSON-копию размером до 50 МБ');await api('/api/restore',{payload:JSON.parse(await file.text()),confirm_replace:form.elements.namedItem('confirm_replace').checked});for(const key of Object.keys(drafts))delete drafts[key];selectedCampaign='';remember();}
  discard(form.id);await load();toast(message);
 }catch(error){handleError(error);}finally{if(button)button.disabled=false;}
});
(async()=>{try{await initialize();}catch(error){showStartupError(error);}})();

</script></body></html>
